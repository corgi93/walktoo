# ─── 환경변수 템플릿 ─────────────────────────────────────
# 이 파일을 복사해서 .env.development / .env.production 만드세요
# cp .env.example .env.development

EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID

# ─── Location Provider (산책 장소 검색) ───────────────────
# 'naver' | 'google' — 미설정 시 디바이스 로케일이 ko* 면 naver, 외엔 google.
EXPO_PUBLIC_LOCATION_PROVIDER=naver

# Naver 지역검색 (https://developers.naver.com)
# 애플리케이션 등록 → "검색" 권한 추가 → Client ID/Secret 발급
EXPO_PUBLIC_NAVER_DEV_CLIENT_ID=
EXPO_PUBLIC_NAVER_DEV_CLIENT_SECRET=

# Naver Cloud Platform Maps (https://www.ncloud.com)
# 네이티브 지도 SDK + Reverse Geocoding 용도. Phase 2에서 필요.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
EXPO_PUBLIC_NCP_API_KEY_ID=
EXPO_PUBLIC_NCP_API_KEY=

# Google Places + Maps (글로벌 fallback)
# https://console.cloud.google.com → Places API + Maps SDK 활성화 →
# iOS bundle id / Android package name 으로 application restriction 필수
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
